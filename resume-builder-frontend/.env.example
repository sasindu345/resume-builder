# =============================================
# FRONTEND ENVIRONMENT VARIABLES - TEMPLATE
# =============================================
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds
#
# Vite loads files in this priority:
#   .env.local          → always loaded, gitignored (your local secrets)
#   .env.production     → loaded only for `vite build` (production values)
#   .env                → always loaded (shared defaults)
#   .env.example        → NOT loaded (this template file)

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# App Info
VITE_APP_NAME=Resume Builder
VITE_APP_VERSION=1.0.0

# Cloudinary (for profile image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# AI Review Feature
VITE_ENABLE_AI_REVIEW=true

# Debug Mode
VITE_DEBUG=false

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=false
